{
  "name": "flomo-safe-sync",
  "version": "0.3.6",
  "description": "Safe, configurable Flomo to Obsidian sync",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test.config.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^8.57.1",
    "eslint-plugin-obsidianmd": "^0.2.9",
    "obsidian": "latest",
    "typescript": "5.0.4",
    "js-yaml": "4.1.1"
  }
}
